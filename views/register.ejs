<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Criar conta — memorizer</title>
    <script>
    (function () {
        try {
            var t = localStorage.getItem('memorizer:theme');
            if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-bs-theme', t);
        } catch (e) {}
    })();
    </script>
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #f6f5f2;
            --surface: #ffffff;
            --surface-2: #efede8;
            --line: rgba(24, 24, 27, .1);
            --text: #18181b;
            --muted: #6b6a72;
            --brand: #ff6a3d;
            --brand-600: #e85325;
            --brand-soft: rgba(255, 106, 61, .13);
            --shadow: 0 10px 30px rgba(24, 24, 27, .06);
        }
        [data-bs-theme="dark"] {
            --bg: #111114;
            --surface: #19191e;
            --surface-2: #222229;
            --line: rgba(255, 255, 255, .09);
            --text: #f4f4f6;
            --muted: #9898a3;
            --brand-soft: rgba(255, 106, 61, .18);
            --shadow: 0 12px 32px rgba(0, 0, 0, .35);
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family: 'Nunito', system-ui, -apple-system, sans-serif;
            color: var(--text);
            background:
                radial-gradient(circle at 85% 10%, var(--brand-soft), transparent 45%),
                var(--bg);
        }
        .auth-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 24px;
        }
        .brand-label {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-weight: 900;
            font-size: 1.15rem;
        }
        .brand-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: var(--brand);
            box-shadow: 0 0 0 4px var(--brand-soft);
        }
        .theme-btn {
            border: 1px solid var(--line);
            background: var(--surface);
            color: var(--text);
            border-radius: 999px;
            padding: 6px 12px;
            font-size: .8rem;
            font-weight: 800;
            cursor: pointer;
        }
        .auth-main {
            flex: 1;
            display: grid;
            place-items: center;
            padding: 16px 20px 44px;
        }
        .auth-card {
            width: 100%;
            max-width: 410px;
            padding: 28px 26px;
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 24px;
            box-shadow: var(--shadow);
        }
        .auth-eyebrow {
            margin: 0 0 4px;
            color: var(--brand-600);
            font-size: .76rem;
            font-weight: 800;
            letter-spacing: .06em;
            text-transform: uppercase;
        }
        h1 {
            margin: 0 0 6px;
            font-size: 1.6rem;
            font-weight: 900;
        }
        .auth-sub {
            margin: 0 0 20px;
            color: var(--muted);
            font-size: .92rem;
        }
        .form-label {
            font-size: .84rem;
            font-weight: 800;
        }
        .form-control {
            height: 44px;
            background: var(--surface-2);
            border: 1px solid var(--line);
            color: var(--text);
            border-radius: 12px;
        }
        .form-control:focus {
            background: var(--surface);
            color: var(--text);
            border-color: var(--brand);
            box-shadow: 0 0 0 3px var(--brand-soft);
        }
        .form-text {
            color: var(--muted);
            font-size: .78rem;
        }
        .btn-brand {
            height: 46px;
            border: 0;
            border-radius: 12px;
            background: var(--brand);
            color: #fff;
            font-weight: 800;
        }
        .btn-brand:hover, .btn-brand:focus {
            background: var(--brand-600);
            color: #fff;
        }
        .auth-switch {
            margin: 18px 0 0;
            padding-top: 14px;
            border-top: 1px solid var(--line);
            text-align: center;
            color: var(--muted);
            font-size: .88rem;
        }
        .auth-switch a {
            color: var(--brand-600);
            font-weight: 800;
            text-decoration: none;
        }
        .auth-switch a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
<%
    const mensagemErro = locals.erro || locals.error || null;
    const nomeAtual = (locals.valores && locals.valores.name) || locals.name || '';
    const emailAtual = (locals.valores && locals.valores.email) || locals.email || '';
%>

<header class="auth-top">
    <span class="brand-label"><span class="brand-dot" aria-hidden="true"></span>memorizer</span>
    <button class="theme-btn" type="button" data-theme-toggle>Tema</button>
</header>

<main class="auth-main">
    <section class="auth-card">
        <p class="auth-eyebrow">Novo treinador</p>
        <h1>Criar conta</h1>
        <p class="auth-sub">Crie seus próprios flash cards e comece a treinar hoje.</p>

        <% if (mensagemErro) { %>
            <div class="alert alert-danger py-2 px-3 small" role="alert"><%= mensagemErro %></div>
        <% } %>

        <form action="/register" method="post">
            <% if (locals.csrfToken) { %>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% } %>
            <div class="mb-3">
                <label class="form-label" for="name">Nome</label>
                <input class="form-control" id="name" name="name" type="text"
                       value="<%= nomeAtual %>" placeholder="Como quer ser chamado"
                       autocomplete="name" required autofocus>
            </div>
            <div class="mb-3">
                <label class="form-label" for="email">E-mail</label>
                <input class="form-control" id="email" name="email" type="email"
                       value="<%= emailAtual %>" placeholder="voce@exemplo.com"
                       autocomplete="username" required>
            </div>
            <div class="mb-3">
                <label class="form-label" for="password">Senha</label>
                <input class="form-control" id="password" name="password" type="password"
                       minlength="6" maxlength="72" placeholder="••••••••"
                       autocomplete="new-password" aria-describedby="passwordHelp" required>
                <div class="form-text" id="passwordHelp">Mínimo de 6 caracteres.</div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="password_confirm">Confirmar senha</label>
                <input class="form-control" id="password_confirm" name="password_confirm" type="password"
                       minlength="6" maxlength="72" placeholder="Repita a senha"
                       autocomplete="new-password" required>
            </div>
            <button class="btn btn-brand w-100" type="submit">Criar conta</button>
        </form>

        <p class="auth-switch">Já tem conta? <a href="/login">Entrar</a></p>
    </section>
</main>

<script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
    var btn = document.querySelector('[data-theme-toggle]');
    if (!btn) return;
    btn.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-bs-theme') || 'light';
        var next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-bs-theme', next);
        try { localStorage.setItem('memorizer:theme', next); } catch (e) {}
    });
})();
</script>
</body>
</html>