<!DOCTYPE html>
<html lang="pt-BR">
<%- include('partials/_head', { title: 'Flash cards', css: 'flashcards' }) %>
<script src="/javascripts/flashcards.js"></script>
<body>
<%- include('partials/_icons') %>

<div class="studio-shell">
    <%- include('partials/_sidebar', { active: 'flashcards' }) %>

    <div class="studio-main">
        <%- include('partials/_topbar', { title: 'Flash cards', subtitle: 'Vire, avalie e revise no seu ritmo' }) %>

        <main class="studio-content">
            <div class="fc-layout">

                <!-- Palco de estudo -->
                <section class="fc-stage s-card" aria-labelledby="deckTitle">
                    <div class="fc-head">
                        <div>
                            <h2 id="deckTitle">Carregando…</h2>
                            <p id="deckDesc"></p>
                        </div>
                        <div class="fc-counter" id="fcCounter" aria-live="polite"></div>
                    </div>

                    <div class="progress fc-progress" role="progressbar" aria-label="Progresso da sessão"
                         aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="fcProgress">
                        <div class="progress-bar" id="fcBar" style="width:0%"></div>
                    </div>

                    <!-- Sessão em andamento -->
                    <div id="fcPlay">
                        <div class="fc-card" id="fcCard" tabindex="0" role="button" aria-label="Virar carta">
                            <div class="fc-inner">
                                <div class="fc-face fc-front">
                                    <span class="fc-tag">Pergunta</span>
                                    <p class="fc-text" id="fcFront"></p>
                                    <span class="fc-hint">
                                        <svg class="ic ic-sm"><use href="#i-flip"/></svg>
                                        Clique ou Espaço para virar
                                    </span>
                                </div>
                                <div class="fc-face fc-back">
                                    <span class="fc-tag">Resposta</span>
                                    <p class="fc-text" id="fcBack"></p>
                                </div>
                            </div>
                            <span class="fc-stamp is-yes" id="fcStampYes" aria-hidden="true">Sei</span>
                            <span class="fc-stamp is-no" id="fcStampNo" aria-hidden="true">Não sei</span>
                        </div>

                        <div class="fc-actions">
                            <button type="button" class="btn-decide is-no" id="fcNo">
                                <svg class="ic"><use href="#i-x"/></svg> Não sei <kbd>←</kbd>
                            </button>
                            <button type="button" class="btn btn-soft fc-flip" id="fcShow">
                                <svg class="ic"><use href="#i-flip"/></svg> Virar
                            </button>
                            <button type="button" class="btn-decide is-yes" id="fcYes">
                                <svg class="ic"><use href="#i-check"/></svg> Sei <kbd>→</kbd>
                            </button>
                        </div>
                        <p class="fc-swipe-hint">Arraste a carta: para a direita se você sabe, para a esquerda se não sabe.</p>
                    </div>

                    <!-- Fim da sessão / deck vazio -->
                    <div id="fcSummary" hidden></div>
                </section>

                <!-- Lateral -->
                <aside class="fc-side" aria-label="Decks e estatísticas">
                    <section class="fc-panel s-card">
                        <h2>Seus decks</h2>
                        <ul class="deck-list" id="deckList"></ul>
                    </section>

                    <section class="fc-panel s-card">
                        <h2>Esta sessão</h2>
                        <dl class="fc-stats">
                            <div><dt>Acertos</dt><dd id="stHits">0</dd></div>
                            <div><dt>Erros</dt><dd id="stMiss">0</dd></div>
                            <div><dt>Pontos</dt><dd id="stPoints">0</dd></div>
                            <div><dt>Tempo</dt><dd id="stTime">00:00</dd></div>
                        </dl>
                        <p class="shortcuts">
                            <kbd>Espaço</kbd> vira &nbsp; <kbd>←</kbd> não sei &nbsp; <kbd>→</kbd> sei
                        </p>
                    </section>

                    <button type="button" class="btn btn-soft btn-new" data-bs-toggle="modal" data-bs-target="#cardModal">
                        <svg class="ic"><use href="#i-plus"/></svg> Novo cartão
                    </button>
                    <button type="button" class="btn btn-soft btn-new" data-bs-toggle="modal" data-bs-target="#deckModal">
                        <svg class="ic"><use href="#i-plus"/></svg> Novo deck
                    </button>
                </aside>

            </div>
        </main>
    </div>
</div>

<div class="modal fade" id="cardModal" tabindex="-1" aria-labelledby="cardModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h2 class="modal-title fs-5" id="cardModalTitle">Adicionar cartões</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                
                <!-- Deck (comum a todos) -->
                <div class="mb-3">
                    <label class="form-label fw-bold" for="newDeck">Deck de destino</label>
                    <select class="form-select" id="newDeck"></select>
                </div>

                <!-- Abas de modo -->
                <ul class="nav nav-tabs mb-3" id="cardModeTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="tab-single-btn" data-bs-toggle="tab" data-bs-target="#tab-single" type="button" role="tab">Único</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-lote-btn" data-bs-toggle="tab" data-bs-target="#tab-lote" type="button" role="tab">Lote (Texto)</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-csv-btn" data-bs-toggle="tab" data-bs-target="#tab-csv" type="button" role="tab">Lote (CSV)</button>
                    </li>
                </ul>

                <div class="tab-content" id="cardModeContent">
                    
                    <!-- Modo 1: Único -->
                    <div class="tab-pane fade show active" id="tab-single" role="tabpanel">
                        <div class="mb-3">
                            <label class="form-label fw-bold" for="newFront">Frente (pergunta)</label>
                            <textarea class="form-control" id="newFront" rows="2" maxlength="300"></textarea>
                            <div class="invalid-feedback">Escreva a pergunta.</div>
                        </div>
                        <div class="mb-1">
                            <label class="form-label fw-bold" for="newBack">Verso (resposta)</label>
                            <textarea class="form-control" id="newBack" rows="2" maxlength="300"></textarea>
                            <div class="invalid-feedback">Escreva a resposta.</div>
                        </div>
                    </div>

                    <!-- Modo 2: Lote por Texto -->
                    <div class="tab-pane fade" id="tab-lote" role="tabpanel">
                        <label class="form-label fw-bold" for="loteText">Cole as frases (frente;verso, uma por linha)</label>
                        <textarea class="form-control font-monospace" id="loteText" rows="6" placeholder="hi;oi&#10;hello;olá&#10;good morning;bom dia"></textarea>
                        <small class="text-muted">Use <strong>;</strong> para separar a frente do verso.</small>
                    </div>

                    <!-- Modo 3: Lote por CSV -->
                    <div class="tab-pane fade" id="tab-csv" role="tabpanel">
                        <label class="form-label fw-bold" for="csvFile">Envie o arquivo .csv</label>
                        <input class="form-control" type="file" id="csvFile" accept=".csv">
                        <small class="text-muted">Formato esperado: <code>frente;verso</code> ou <code>frente,verso</code> por linha.</small>
                    </div>
                </div>

                <!-- Resumo / Feedback -->
                <div id="importFeedback" class="mt-3"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-soft" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="saveCard">Salvar</button>
            </div>
        </div>
    </div>
</div>

<!-- Novo deck -->
<div class="modal fade" id="deckModal" tabindex="-1" aria-labelledby="deckModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="formNovoDeck">
            <div class="modal-header border-0 pb-0">
                <h2 class="modal-title fs-5" id="deckModalTitle">Novo deck</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold" for="newDeckName">Nome do deck</label>
                    <input type="text" class="form-control" id="newDeckName" name="name" maxlength="100">
                    <div class="invalid-feedback">Escreva o nome do deck.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold" for="newDeckdescription">Nome do deck</label>
                    <input type="text" class="form-control" id="newDeckdescription" name="description" maxlength="100">
                    <div class="invalid-feedback">Descreva o conteúdo.</div>
                </div>
                <div class="mb-1">
                    <label class="form-label fw-bold" for="newDeckColor">Cor</label>
                    <input type="color" class="form-control form-control-color" id="newDeckColor" name="color" value="#5b6cff">
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-soft" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary" id="saveDeck">Criar deck</button>
            </div>
        </form>
    </div>
</div>

<%- include('partials/_scripts') %>

<!--
    DADOS DA TELA (opcional): a rota envia `pageData`. Sem ele, o script usa os decks de exemplo.
    {
      decks: [{ id, name, description, color, cards: [{ id, front, back }] }],
      deckAtual: 'id'            // opcional; também aceita ?deck=id na URL
    }
-->
<script type="application/json" id="pageData"><%- JSON.stringify(locals.pageData || null).replace(/</g, '\\u003c') %></script>

<script>
(function () {
    /* ======================================================
       Dados de exemplo
    ====================================================== */

    const demo = {
        deckAtual: 'ingles',
        decks: [
            {
                id: 'ingles', name: 'Inglês do dia a dia', color: '#5b6cff',
                description: 'Vocabulário e expressões para conversar e trabalhar.',
                cards: [
                    { id: 'i1', front: 'Como se diz “prazo” em inglês?', back: 'Deadline' },
                    { id: 'i2', front: 'Traduza: “I’m looking forward to it.”', back: 'Estou ansioso por isso.' },
                    { id: 'i3', front: 'O que significa “to run out of”?', back: 'Ficar sem, esgotar (ex.: run out of time).' },
                    { id: 'i4', front: 'Diferença entre “borrow” e “lend”?', back: 'Borrow = pegar emprestado. Lend = emprestar a alguém.' },
                    { id: 'i5', front: 'Como se diz “desde que” (condição)?', back: 'As long as / provided that' },
                    { id: 'i6', front: 'Traduza: “It depends.”', back: 'Depende.' },
                    { id: 'i7', front: 'O que é “a heads-up”?', back: 'Um aviso antecipado.' },
                    { id: 'i8', front: 'Plural de “analysis”', back: 'Analyses' }
                ]
            },
            {
                id: 'redes', name: 'Redes e infraestrutura', color: '#12b886',
                description: 'Portas, protocolos e conceitos que caem sempre.',
                cards: [
                    { id: 'r1', front: 'Qual a porta padrão do HTTPS?', back: '443' },
                    { id: 'r2', front: 'O que significa DNS?', back: 'Domain Name System: traduz nomes de domínio em endereços IP.' },
                    { id: 'r3', front: 'Qual a porta padrão do SSH?', back: '22' },
                    { id: 'r4', front: 'Para que serve o DHCP?', back: 'Atribuir endereços IP automaticamente aos dispositivos da rede.' },
                    { id: 'r5', front: 'O que é uma VLAN?', back: 'Uma rede local virtual: separa o tráfego logicamente no mesmo switch.' },
                    { id: 'r6', front: 'O que representa a máscara /24?', back: '255.255.255.0: 254 endereços utilizáveis.' },
                    { id: 'r7', front: 'Em que camada do modelo OSI atua o roteador?', back: 'Camada 3 (Rede).' },
                    { id: 'r8', front: 'Qual comando testa a conectividade com um host?', back: 'ping' }
                ]
            },
            {
                id: 'dicom', name: 'DICOM e PACS', color: '#f59f00',
                description: 'Imagem médica: conceitos e serviços principais.',
                cards: [
                    { id: 'd1', front: 'O que significa DICOM?', back: 'Digital Imaging and Communications in Medicine.' },
                    { id: 'd2', front: 'O que é um PACS?', back: 'Sistema de arquivamento e comunicação de imagens médicas.' },
                    { id: 'd3', front: 'O que é um SR no DICOM?', back: 'Structured Report: um laudo estruturado.' },
                    { id: 'd4', front: 'O que é a Modality Worklist (MWL)?', back: 'Lista de exames agendados enviada ao equipamento pelo RIS/PACS.' },
                    { id: 'd5', front: 'O que identifica unicamente um estudo?', back: 'O Study Instance UID.' },
                    { id: 'd6', front: 'Para que serve o HL7?', back: 'Troca de mensagens de saúde entre sistemas (ADT, ORM, ORU…).' },
                    { id: 'd7', front: 'O que faz o serviço C-STORE?', back: 'Envia imagens de um sistema para outro (destino SCP).' },
                    { id: 'd8', front: 'Qual a porta DICOM registrada mais conhecida?', back: '104 (e 11112 como alternativa sem privilégios).' }
                ]
            }
        ]
    };

    let injetado = null;
    try { injetado = JSON.parse(document.getElementById('pageData').textContent); } catch (e) { injetado = null; }
    const dados = injetado || demo;

    /* ======================================================
        PRODUÇÃO: salvar um cartão novo
        ====================================================== */
        async function salvarCartao(deckId, cartao) {
            console.info("entrei")
            console.info(cartao.front+": front" + cartao.back + ": back")
            const resp = await fetch(`/api/decks/${deckId}/cartoes`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ front: cartao.front, back: cartao.back })
            });

            if (!resp.ok) {
                const err = await resp.json().catch(() => ({}));
                throw new Error(err.erro || 'Erro ao salvar cartão.');
            }

            return resp.json();
        }

    /* ======================================================
       Utilitários e estado
    ====================================================== */

    const esc = Studio.esc;
    const $ = (id) => document.getElementById(id);
    const decks = dados.decks || [];

    let deck = null;
    let sessao = null;
    let relogio = null;
    let animando = false;
    let ignorarClique = false;

    const PONTOS_SEI = 8; // metade quando a carta já tinha voltado para a fila

    function embaralhar(lista) {
        const copia = [...lista];
        for (let i = copia.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [copia[i], copia[j]] = [copia[j], copia[i]];
        }
        return copia;
    }

    function formatarTempo(ms) {
        const total = Math.floor(ms / 1000);
        return `${String(Math.floor(total / 60)).padStart(2, '0')}:${String(total % 60).padStart(2, '0')}`;
    }

    /* ======================================================
       Renderização
    ====================================================== */

    function renderDecks() {
        $('deckList').innerHTML = decks.map((d) => `
            <li>
                <button type="button" class="deck-item" data-deck="${esc(d.id)}" style="--dot:${esc(d.color)}"
                        aria-current="${deck && Number(d.id) === Number(deck.id)}">
                    <span class="deck-dot"></span>
                    <span class="deck-name">${esc(d.name)}<small>${d.cards.length} ${d.cards.length === 1 ? 'cartão' : 'cartões'}</small></span>
                    <span class="deck-count">${d.cards.length}</span>
                </button>
            </li>`).join('');

        $('newDeck').innerHTML = decks.map((d) => `<option value="${esc(d.id)}">${esc(d.name)}</option>`).join('');
    }

    function renderCabecalho() {
        $('deckTitle').textContent = deck ? deck.name : 'Nenhum deck';
        $('deckDesc').textContent = deck ? deck.description || '' : '';

        if (!sessao) {
            $('fcCounter').textContent = '';
            $('fcBar').style.width = '0%';
            return;
        }

        const atual = Math.min(sessao.feitas + 1, sessao.total);
        const pct = Math.round((sessao.feitas / sessao.total) * 100);
        $('fcCounter').innerHTML = `Carta <strong>${atual}</strong> de ${sessao.total}`;
        $('fcBar').style.width = `${pct}%`;
        $('fcProgress').setAttribute('aria-valuenow', pct);
    }

    function renderEstatisticas() {
        $('stHits').textContent = sessao ? sessao.acertos : 0;
        $('stMiss').textContent = sessao ? sessao.erros : 0;
        $('stPoints').textContent = sessao ? sessao.pontos : 0;
        $('stTime').textContent = sessao ? formatarTempo(Date.now() - sessao.inicio) : '00:00';
    }

    // Tira qualquer efeito de arraste que tenha ficado no cartão
    function resetarCartao() {
        const card = $('fcCard');
        card.style.transition = '';
        card.style.transform = '';
        card.style.opacity = '';
        card.style.removeProperty('--p');
        delete card.dataset.dir;
        $('fcStampYes').style.opacity = 0;
        $('fcStampNo').style.opacity = 0;
    }

    function mostrarCarta(animar, instantaneo) {
        const carta = sessao.fila[0];
        const card = $('fcCard');
        const estavaVirada = card.classList.contains('is-flipped');

        resetarCartao();
        $('fcFront').textContent = carta.front;
        card.setAttribute('aria-label', `Virar carta. Pergunta: ${carta.front}`);

        if (instantaneo) {
            // O cartão acabou de sair da tela: desvira sem animar e já troca o verso
            card.classList.add('no-flip-anim');
            card.classList.remove('is-flipped');
            $('fcBack').textContent = carta.back;
            void card.offsetWidth;
            card.classList.remove('no-flip-anim');
        } else {
            card.classList.remove('is-flipped');
            // O verso só troca depois que a carta termina de desvirar (evita "spoiler")
            const aplicarVerso = () => { if (sessao && sessao.fila[0] === carta) $('fcBack').textContent = carta.back; };
            if (estavaVirada) setTimeout(aplicarVerso, 280); else aplicarVerso();
        }

        if (animar) {
            card.classList.add('is-entering');
            card.addEventListener('animationend', () => card.classList.remove('is-entering'), { once: true });
        }
        renderCabecalho();
    }

    function mostrarVazio() {
        sessao = null;
        $('fcPlay').hidden = true;
        $('fcSummary').hidden = false;
        $('fcSummary').innerHTML = `
            <div class="fc-empty">
                <svg class="ic" style="font-size:2.2rem"><use href="#i-cards"/></svg>
                <strong>Este deck ainda não tem cartões.</strong>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#cardModal">Adicionar o primeiro</button>
            </div>`;
        renderCabecalho();
        renderEstatisticas();
    }

    /* ======================================================
       Sessão de estudo
    ====================================================== */

    function iniciar(id) {
        deck = decks.find((d) => Number(d.id) === Number(id)) || decks[0];
        clearInterval(relogio);
        renderDecks();

        if (!deck) {
            $('deckTitle').textContent = 'Nenhum deck';
            return mostrarVazio();
        }
        if (!deck.cards.length) return mostrarVazio();

        sessao = {
            fila: embaralhar(deck.cards).map((c) => ({ ...c, tentativas: 0 })),
            total: deck.cards.length,
            feitas: 0, acertos: 0, erros: 0, pontos: 0,
            inicio: Date.now()
        };

        $('fcPlay').hidden = false;
        $('fcSummary').hidden = true;

        relogio = setInterval(renderEstatisticas, 1000);
        mostrarCarta(true);
        renderEstatisticas();
        Studio.registrar({ tipo: 'flashcards:inicio', deckId: deck.id });
    }

    function virar() {
        if (!sessao || !sessao.fila.length || animando) return;

        $('fcBack').textContent = sessao.fila[0].back;
        $('fcCard').classList.toggle('is-flipped');
    }

    // Registra a resposta e passa para a próxima carta (o "next()" do fluxo)
    function avaliar(sei) {
        if (!sessao || !sessao.fila.length) return;

        const carta = sessao.fila.shift();
        let pontos = 0;

        if (sei) {
            pontos = carta.tentativas ? Math.round(PONTOS_SEI / 2) : PONTOS_SEI;
            sessao.acertos++;
            sessao.feitas++;
        } else {
            // Não sei: a carta volta algumas posições adiante
            sessao.erros++;
            carta.tentativas++;
            sessao.fila.splice(Math.min(3, sessao.fila.length), 0, carta);
        }

        if (pontos > 0) {
            sessao.pontos += pontos;
            Studio.addPoints(pontos, 'flashcards', `Carta: ${carta.front}`);
        }

        Studio.registrar({ tipo: 'flashcards:avaliacao', deckId: deck.id, cardId: carta.id, sabia: sei });

        renderEstatisticas();
        if (sessao.fila.length) mostrarCarta(true, true); else finalizar();
    }

    function finalizar() {
        clearInterval(relogio);

        const perfeita = sessao.erros === 0;
        const bonus = perfeita ? 15 : 5;
        sessao.pontos += bonus;
        Studio.addPoints(bonus, 'flashcards', perfeita ? 'Sessão perfeita' : 'Sessão concluída');

        const duracao = Date.now() - sessao.inicio;
        const tentativas = sessao.acertos + sessao.erros;
        const precisao = tentativas ? Math.round((sessao.acertos / tentativas) * 100) : 0;

        Studio.registrar({
            tipo: 'flashcards:sessao', deckId: deck.id, cartas: sessao.total,
            acertos: sessao.acertos, erros: sessao.erros, pontos: sessao.pontos, duracaoMs: duracao
        });

        $('fcPlay').hidden = true;
        $('fcSummary').hidden = false;
        $('fcSummary').innerHTML = `
            <div class="fc-summary">
                <span class="fc-summary-ico"><svg class="ic"><use href="#i-check"/></svg></span>
                <h3>${perfeita ? 'Sessão perfeita!' : 'Sessão concluída!'}</h3>
                <p>Você revisou ${sessao.total} ${sessao.total === 1 ? 'cartão' : 'cartões'} de “${esc(deck.name)}” (+${bonus} pts de bônus).</p>
                <div class="fc-summary-stats">
                    <div><strong>${precisao}%</strong><span>precisão</span></div>
                    <div><strong>${sessao.erros}</strong><span>erros</span></div>
                    <div><strong>+${sessao.pontos}</strong><span>pontos</span></div>
                    <div><strong>${formatarTempo(duracao)}</strong><span>tempo</span></div>
                </div>
                <div class="fc-summary-actions">
                    <button type="button" class="btn btn-primary" data-acao="repetir">Estudar de novo</button>
                    <a class="btn btn-soft" href="/">Voltar ao início</a>
                </div>
            </div>`;

        $('fcBar').style.width = '100%';
        $('fcCounter').textContent = 'Concluído';
        renderEstatisticas();
    }

    /* ======================================================
       Eventos
    ====================================================== */

    const alvo = $('fcCard');
    const reduzMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let arraste = null;

    // Distância mínima do arraste para valer como resposta
    const limiar = () => Math.max(90, alvo.offsetWidth * 0.22);

    // Mostra "Sei" / "Não sei" e o brilho da borda conforme a carta é arrastada
    function indicar(dx) {
        const p = Math.min(1, Math.abs(dx) / limiar());
        alvo.dataset.dir = Math.abs(dx) > 18 ? (dx > 0 ? 'yes' : 'no') : '';
        alvo.style.setProperty('--p', p.toFixed(2));
        $('fcStampYes').style.opacity = dx > 0 ? p : 0;
        $('fcStampNo').style.opacity = dx < 0 ? p : 0;
    }

    // Botões, teclado e arraste passam por aqui: a carta sai voando e vem a próxima
    function decidir(sei) {
        if (animando || !sessao || !sessao.fila.length) return;
        animando = true;

        const direcao = sei ? 1 : -1;
        const daSessao = sessao;
        indicar(direcao * limiar());

        const concluir = () => {
            if (sessao === daSessao) avaliar(sei);
            animando = false;
        };
        if (reduzMovimento) return concluir();

        alvo.style.transition = 'transform .32s ease-in, opacity .32s ease-in';
        alvo.style.transform = `translateX(${direcao * Math.max(520, window.innerWidth * 0.8)}px) rotate(${direcao * 24}deg)`;
        alvo.style.opacity = '0';
        setTimeout(concluir, 320);
    }

    function voltarAoCentro() {
        alvo.style.transition = 'transform .28s cubic-bezier(.3,.7,.2,1)';
        alvo.style.transform = '';
        indicar(0);
        setTimeout(() => { if (!animando) alvo.style.transition = ''; }, 300);
    }

    alvo.addEventListener('pointerdown', (e) => {
        if (animando || !sessao || (e.pointerType === 'mouse' && e.button !== 0)) return;
        arraste = { id: e.pointerId, x: e.clientX, y: e.clientY, dx: 0, ativo: false };
    });

    alvo.addEventListener('pointermove', (e) => {
        if (!arraste || e.pointerId !== arraste.id) return;

        const dx = e.clientX - arraste.x;
        const dy = e.clientY - arraste.y;

        if (!arraste.ativo) {
            // Só começa a arrastar se o movimento for mais horizontal que vertical
            if (Math.abs(dx) < 10 || Math.abs(dx) < Math.abs(dy)) return;
            arraste.ativo = true;
            alvo.setPointerCapture(e.pointerId);
            alvo.classList.add('is-dragging');
        }

        arraste.dx = dx;
        alvo.style.transition = 'none';
        alvo.style.transform = `translateX(${dx}px) rotate(${dx / 18}deg)`;
        indicar(dx);
    });

    function soltar(e, cancelado) {
        if (!arraste || e.pointerId !== arraste.id) return;

        const a = arraste;
        arraste = null;
        if (!a.ativo) return;

        alvo.classList.remove('is-dragging');
        ignorarClique = true; // o clique que vem depois do arraste não deve virar a carta
        setTimeout(() => { ignorarClique = false; }, 60);

        if (!cancelado && Math.abs(a.dx) >= limiar()) decidir(a.dx > 0); else voltarAoCentro();
    }

    alvo.addEventListener('pointerup', (e) => soltar(e, false));
    alvo.addEventListener('pointercancel', (e) => soltar(e, true));
    alvo.addEventListener('click', () => { if (!ignorarClique) virar(); });

    $('fcShow').addEventListener('click', virar);
    $('fcYes').addEventListener('click', () => decidir(true));
    $('fcNo').addEventListener('click', () => decidir(false));

    $('deckList').addEventListener('click', (e) => {
        const botao = e.target.closest('[data-deck]');
        if (botao && (!deck || Number(botao.dataset.deck) !== Number(deck.id))) {
            iniciar(botao.dataset.deck);
        }
    });

    $('fcSummary').addEventListener('click', (e) => {
        if (e.target.closest('[data-acao="repetir"]')) iniciar(deck.id);
    });

    document.addEventListener('keydown', (e) => {
        if (document.body.classList.contains('modal-open')) return;
        if (e.target.matches('input, textarea, select')) return;
        if (!sessao || !sessao.fila.length) return;

        if (e.key === ' ' || e.key === 'Enter') {
            if (e.target.closest('button, a')) return; // o próprio botão já reage ao teclado
            e.preventDefault();
            virar();
        } else if (e.key === 'ArrowRight') {
            e.preventDefault();
            decidir(true);
        } else if (e.key === 'ArrowLeft') {
            e.preventDefault();
            decidir(false);
        }
    });

    // ---------- Novo deck ----------
    const deckModalEl = $('deckModal');
    const formNovoDeck = $('formNovoDeck');

    if (formNovoDeck) {
        formNovoDeck.addEventListener('submit', async (e) => {
            e.preventDefault();

            const nome = $('newDeckName').value.trim();
            const description = $('newDeckdescription').value.trim();
            const cor = $('newDeckColor').value;

            $('newDeckName').classList.toggle('is-invalid', !nome);
            if (!nome) return;

            const btn = $('saveDeck');
            btn.disabled = true;
            btn.textContent = 'Criando...';

            try {
                const resp = await fetch('/api/decks', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: nome, description: description, color: cor })
                });

                if (!resp.ok) {
                    const err = await resp.json().catch(() => ({}));
                    throw new Error(err.erro || 'Erro ao criar deck.');
                }

                const novo = await resp.json();
                decks.push(novo);
                renderDecks();
                window.bootstrap.Modal.getInstance(deckModalEl).hide();
                Studio.toast('Deck criado com sucesso!');
                formNovoDeck.reset();
            } catch (erro) {
                console.error(erro);
                Studio.toast(erro.message || 'Erro ao criar deck.');
            } finally {
                btn.disabled = false;
                btn.textContent = 'Criar deck';
            }
        });
    }

    /* ---------- Novo cartão ---------- */

    const modalEl = $('cardModal');

    modalEl.addEventListener('show.bs.modal', () => {
        if (deck) $('newDeck').value = String(deck.id);
        ['newFront', 'newBack', 'loteText'].forEach((id) => { $(id).value = ''; $(id).classList.remove('is-invalid'); });
        $('csvFile').value = '';
        $('importFeedback').innerHTML = '';
        // Volta para a aba "Único"
        const tabSingle = document.getElementById('tab-single-btn');
        if (tabSingle) new bootstrap.Tab(tabSingle).show();
    });

    modalEl.addEventListener('shown.bs.modal', () => $('newFront').focus());

    $('saveCard').addEventListener('click', async () => {
        const destinoId = Number($('newDeck').value);
        const destino = decks.find((d) => Number(d.id) === destinoId);
        if (!destino) return alert('Selecione um deck válido.');

        // Descobre qual aba está ativa
        const abaAtiva = document.querySelector('#cardModeTabs .nav-link.active').id;

        const btn = $('saveCard');
        btn.disabled = true;
        btn.textContent = 'Salvando...';
        $('importFeedback').innerHTML = '';

        try {
            let cartoesParaSalvar = [];

            if (abaAtiva === 'tab-single-btn') {
                const frente = $('newFront').value.trim();
                const verso = $('newBack').value.trim();
                if (!frente || !verso) {
                    $('newFront').classList.toggle('is-invalid', !frente);
                    $('newBack').classList.toggle('is-invalid', !verso);
                    throw new Error('Preencha frente e verso.');
                }
                cartoesParaSalvar.push({ front: frente, back: verso });

            } else if (abaAtiva === 'tab-lote-btn') {
                const texto = $('loteText').value.trim();
                if (!texto) throw new Error('Cole ao menos uma linha no formato frente;verso.');
                
                const linhas = texto.split('\n');
                linhas.forEach((linha) => {
                    const [frente, verso] = linha.split(';').map(s => s.trim());
                    if (frente && verso) cartoesParaSalvar.push({ front: frente, back: verso });
                });

            } else if (abaAtiva === 'tab-csv-btn') {
                const arquivo = $('csvFile').files[0];
                if (!arquivo) throw new Error('Selecione um arquivo .csv.');
                const conteudo = await arquivo.text();
                const linhas = conteudo.split('\n');
                linhas.forEach((linha) => {
                    // Aceita ; ou ,
                    const sep = linha.includes(';') ? ';' : ',';
                    const [frente, verso] = linha.split(sep).map(s => s.trim());
                    if (frente && verso) cartoesParaSalvar.push({ front: frente, back: verso });
                });
            }

            if (!cartoesParaSalvar.length) throw new Error('Nenhum cartão válido encontrado.');

            // Envia um por um (sequencial para não estressar o banco)
            let sucesso = 0;
            for (const c of cartoesParaSalvar) {
                try {
                    const novo = await salvarCartao(destino.id, c);
                    destino.cards.push(novo);
                    sucesso++;
                } catch (e) {
                    console.error('Falha ao salvar cartão:', c, e);
                }
            }

            // Atualiza UI
            renderDecks();
            if (sessao && deck && Number(destino.id) === Number(deck.id)) {
                sessao.total = destino.cards.length;
                renderCabecalho();
            }

            $('importFeedback').innerHTML = `<div class="alert alert-success mb-0">${sucesso} cartão(ões) salvos com sucesso!</div>`;
            
            if (sucesso === cartoesParaSalvar.length) {
                setTimeout(() => {
                    window.bootstrap.Modal.getInstance(modalEl).hide();
                    Studio.toast(`${sucesso} cartão(ões) adicionados!`);
                    // Limpa o form
                    $('newFront').value = ''; $('newBack').value = '';
                    $('loteText').value = ''; $('csvFile').value = '';
                }, 1200);
            }
        } catch (erro) {
            console.error(erro);
            $('importFeedback').innerHTML = `<div class="alert alert-danger mb-0">${erro.message}</div>`;
        } finally {
            btn.disabled = false;
            btn.textContent = 'Salvar';
        }
    });

    /* ======================================================
       Início
    ====================================================== */

    const pedido = new URLSearchParams(location.search).get('deck');
    iniciar(pedido || dados.deckAtual || (decks[0] && decks[0].id));
})();
</script>
</body>
</html>
